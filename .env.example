# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
#   cp .env.example .env      # then edit .env
#
# Every script in this repo reads the key from the environment. On Windows the
# simplest permanent option is instead:
#
#   setx OPENAI_API_KEY "sk-..."     (then open a NEW terminal)
#
# Needs access to: gpt-5-mini (harnesses) and gpt-5.2 (extractor).
OPENAI_API_KEY=

# Optional: path to the prebuilt news index (default: data/news.db)
# BL_INDEX=
